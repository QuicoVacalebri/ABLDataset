{
  "hardware": {
    "gpu": "NVIDIA RTX 4090",
    "vram_gb": 24,
    "cuda_version": "12.1",
    "framework": "PyTorch"
  },
  "common_settings": {
    "dataset": "ABLDataset",
    "num_classes": 1,
    "class_names": ["active_blue_light"],
    "train_images": 2112,
    "val_images": 482,
    "test_images": 455,
    "input_augmentation": "fisheye distortion simulation (Sec. III.A.4) + geometric/photometric augmentation",
    "random_seed": 42
  },
  "models": {
    "RetinaNet": {
      "backbone": "ResNet-50 + FPN",
      "pretrained_weights": "COCO",
      "framework": "torchvision",
      "input_size": 640,
      "batch_size": 16,
      "epochs": 100,
      "optimizer": "SGD",
      "learning_rate": 0.01,
      "weight_decay": 0.0001,
      "momentum": 0.9,
      "focal_loss_alpha": 0.25,
      "focal_loss_gamma": 2.0,
      "confidence_threshold_eval": 0.8,
      "nms_iou_threshold": 0.8,
      "notes": "Approximate configuration; exact schedule not logged."
    },
    "FasterRCNN": {
      "backbone": "ResNet-50 + FPN",
      "pretrained_weights": "COCO",
      "framework": "torchvision",
      "input_size": 640,
      "batch_size": 8,
      "epochs": 100,
      "optimizer": "SGD",
      "learning_rate": 0.005,
      "weight_decay": 0.0001,
      "momentum": 0.9,
      "rpn_anchor_scales": [32, 64, 128, 256, 512],
      "rpn_anchor_ratios": [0.5, 1.0, 2.0],
      "confidence_threshold_eval": 0.8,
      "nms_iou_threshold": 0.8,
      "notes": "Approximate configuration; exact schedule not logged."
    },
    "YOLOv5_M": {
      "framework": "ultralytics YOLOv5",
      "variant": "YOLOv5-M",
      "pretrained_weights": "COCO (yolov5m.pt)",
      "input_size": 640,
      "batch_size": 32,
      "epochs": 150,
      "optimizer": "SGD",
      "learning_rate_initial": 0.01,
      "learning_rate_final_fraction": 0.01,
      "momentum": 0.937,
      "weight_decay": 0.0005,
      "warmup_epochs": 3,
      "confidence_threshold_eval": 0.8,
      "nms_iou_threshold": 0.8
    },
    "YOLOv8_M": {
      "framework": "ultralytics YOLOv8",
      "variant": "YOLOv8-M",
      "pretrained_weights": "COCO (yolov8m.pt)",
      "input_size": 640,
      "batch_size": 32,
      "epochs": 150,
      "optimizer": "AdamW",
      "learning_rate_initial": 0.001,
      "learning_rate_final_fraction": 0.01,
      "momentum": 0.937,
      "weight_decay": 0.0005,
      "warmup_epochs": 3,
      "confidence_threshold_eval": 0.8,
      "nms_iou_threshold": 0.8
    },
    "YOLOv10_M": {
      "framework": "ultralytics YOLOv10",
      "variant": "YOLOv10-M",
      "pretrained_weights": "COCO (yolov10m.pt)",
      "input_size": 640,
      "batch_size": 32,
      "epochs": 150,
      "optimizer": "AdamW",
      "learning_rate_initial": 0.001,
      "learning_rate_final_fraction": 0.01,
      "momentum": 0.937,
      "weight_decay": 0.0005,
      "warmup_epochs": 3,
      "confidence_threshold_eval": 0.8,
      "nms_iou_threshold": 0.8
    },
    "RT-DETR": {
      "framework": "ultralytics RT-DETR",
      "backbone": "ResNet-50",
      "pretrained_weights": "COCO (rtdetr-l.pt)",
      "input_size": 640,
      "batch_size": 16,
      "epochs": 150,
      "optimizer": "AdamW",
      "learning_rate_initial": 0.0001,
      "weight_decay": 0.0001,
      "warmup_epochs": 3,
      "num_queries": 300,
      "confidence_threshold_eval": 0.8
    },
    "CA_RT-DETR_ours": {
      "framework": "ultralytics RT-DETR (modified)",
      "backbone": "ResNet-50",
      "pretrained_weights": "COCO (rtdetr-l.pt, approximate) + randomly initialized Color Attention block",
      "input_size": 640,
      "batch_size": 16,
      "epochs": 150,
      "optimizer": "AdamW",
      "learning_rate_initial": 0.0001,
      "weight_decay": 0.0001,
      "warmup_epochs": 3,
      "num_queries": 300,
      "color_attention_module": {
        "color_space": "HSV",
        "masks": ["pure_blue_range", "bluish_white_range"],
        "residual_connection": "output = x + (x * mask)",
        "placement": "before transformer encoder/backbone stem"
      },
      "confidence_threshold_eval": 0.8   
    }
  }
}